FROM mcr.microsoft.com/playwright:v1.49.0-noble

# Upgrade to Node 24 — default image ships Node 22.11.0 which is incompatible
# with nuxt@3.21 (requires >=22.12.0) and oxc-parser
RUN npm install -g n --silent && n 24 --quiet
ENV PATH="/usr/local/bin:${PATH}"
RUN node --version

WORKDIR /app

# .dockerignore excludes: node_modules, .output, .nuxt, package-lock.json, .env
COPY . .

# Clean install — no lockfile to avoid cross-platform native binding issues
RUN npm install --legacy-peer-deps --no-audit --no-fund

# Build Nuxt application
RUN NODE_ENV=production npm run build

# Install exact Chromium version required by @playwright/test@1.44.0 (build v1117)
RUN npx playwright install chromium

# Start server in background, wait for ready, then run E2E tests
CMD ["sh", "-c", \
  "NITRO_PORT=3005 node .output/server/index.mjs > /tmp/server.log 2>&1 & \
  echo 'Waiting for server on :3005...' && \
  timeout 30 bash -c 'until curl -sf http://localhost:3005 > /dev/null; do sleep 1; done' && \
  echo 'Server ready!' && \
  npx playwright test tests/e2e/responsive-layout.spec.ts --project='Mobile Chrome'; \
  code=$?; echo '=== SERVER LOG ===' && cat /tmp/server.log; exit $code"]
