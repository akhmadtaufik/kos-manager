# URL Utama Aplikasi
AUTH_ORIGIN=http://localhost:3000

# Rahasia acak untuk mengenkripsi sesi (Gunakan: openssl rand -base64 32)
AUTH_SECRET=your-secret-key-here

# Kredensial Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# DOCKER DATABASE CONTAINER CONFIG
# ==========================================
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=kosmanager
DOCKER_DB_CONTAINER=kosmanager-db

# ==========================================
# DATABASE CONNECTIONS
# ==========================================
# Untuk Docker: gunakan host.docker.internal (BUKAN localhost)
DATABASE_URL="postgres://postgres:your-password@host.docker.internal:5432/kosmanager_db"

# Untuk menjalankan drizzle-kit & db-sync dari terminal lokal (di luar Docker)
DATABASE_MIGRATE_URL="postgres://postgres:your-password@localhost:5432/kosmanager_db"
